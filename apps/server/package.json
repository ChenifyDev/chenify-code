{
	"name": "server",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"scripts": {
		"dev": "tsx watch --env-file=../../.env src/index.ts",
		"seed": "tsx --env-file=../../.env seed.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"works:push": "drizzle-kit push --config drizzle-works.config.ts",
		"works:generate": "drizzle-kit generate --config drizzle-works.config.ts",
		"works:migrate": "drizzle-kit migrate --config drizzle-works.config.ts",
		"works:studio": "drizzle-kit studio --config drizzle-works.config.ts",
		"db:push:neon": "drizzle-kit push --config drizzle-neon.config.ts",
		"db:generate:neon": "drizzle-kit generate --config drizzle-neon.config.ts",
		"build": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@chenify/storage": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@neondatabase/serverless": "^1.1.0",
		"@tiptap/core": "^3.30.2",
		"@vercel/blob": "^2.8.0",
		"argon2": "^0.44.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.3",
		"sharp": "^0.34.3",
		"tsx": "^4.23.12"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.13.3",
		"better-sqlite3": "^13.0.3",
		"drizzle-kit": "^0.31.10"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
